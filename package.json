{
  "name": "itypora",
  "version": "0.1.0",
  "description": "类 Typora 的所见即所得 Markdown 编辑器",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "test:smoke": "xvfb-run -a node tests/smoke.mjs"
  },
  "build": {
    "appId": "com.hongfei.itypora",
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "productName": "iTypora"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "markdown-it": "^15.0.2"
  },
  "license": "MIT"
}
